<script>
  const obs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible');}),{threshold:0.1});
  document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));
  const sN=document.querySelectorAll('.stat-number');
  const sD=[{v:17,s:'',p:''},{v:1.4,s:'M',p:'$'},{v:14.3,s:'%',p:'±'}];
  const sO=new IntersectionObserver(es=>{es.forEach((e,i)=>{if(!e.isIntersecting)return;const d=sD[i],el=e.target,fl=d.v%1!==0;let t=null;const run=ts=>{if(!t)t=ts;const p=Math.min((ts-t)/1500,1),ev=1-Math.pow(1-p,3),c=ev*d.v;el.textContent=d.p+(fl?c.toFixed(1):Math.floor(c))+d.s;if(p<1)requestAnimationFrame(run);};requestAnimationFrame(run);sO.unobserve(el);});},{threshold:0.5});
  sN.forEach(el=>sO.observe(el));
  const opts=document.querySelectorAll('.qopt');let cur=1;
  setInterval(()=>{opts[cur].classList.remove('on');cur=(cur+1)%opts.length;opts[cur].classList.add('on');},2200);
</script>
